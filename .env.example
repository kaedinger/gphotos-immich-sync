# Copy to .env and fill in.

IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=

# Path to Google OAuth client secrets (Desktop app credentials).
# Create at https://console.cloud.google.com/ -> APIs & Services -> Credentials
# -> Create OAuth client ID -> Application type: Desktop app.
# Then enable the "Photos Picker API" for the project.
GOOGLE_CREDENTIALS=credentials.json

# Where the cached OAuth token is stored. Optional; defaults to ~/.gphotos-immich-sync/token.json
# GOOGLE_TOKEN=

# JSON list of Google Photos album names to sync (output of scripts/list_google_albums.js).
# Optional; defaults to albums.json in the current working directory.
# GOOGLE_ALBUMS_FILE=
